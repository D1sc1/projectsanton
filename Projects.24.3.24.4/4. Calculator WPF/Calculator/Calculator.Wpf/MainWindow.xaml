<Window x:Class="Calculator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculator.Wpf" xmlns:viewmodels="clr-namespace:Calculator.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Калькулятор" Height="600" Width="460" MinHeight="500" MinWidth="380"
        PreviewTextInput="Window_PreviewTextInput" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.DataContext>
        <viewmodels:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="WhiteSmoke" />
        </Style>

        <Style x:Key="OperationButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="AliceBlue" />
            <Setter Property="FontSize" Value="22" />
        </Style>

        <Style x:Key="MemoryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="ClearButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="MistyRose" />
            <Setter Property="FontSize" Value="22" />
        </Style>

        <Style x:Key="EqualButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="LightGreen" />
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Text="{Binding ExpressionText}" TextAlignment="Right" FontSize="18"
                   Background="Black" Foreground="DarkGray" Margin="4,4,4,0" Padding="10,4" MinHeight="32" />

        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Text="{Binding DisplayValue}" TextAlignment="Right" FontSize="44"
                   Background="Black" Margin="4,0,4,4" Padding="10,0,10,6">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="Linen" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="OrangeRed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Text="{Binding MemoryText}" FontSize="14" FontWeight="Bold"
                   Foreground="DarkBlue" Margin="8,0" MinHeight="20" />

        <Button Grid.Row="3" Grid.Column="0" Content="MC" Style="{StaticResource MemoryButtonStyle}" Command="{Binding MemoryClearCommand}" />
        <Button Grid.Row="3" Grid.Column="1" Content="MR" Style="{StaticResource MemoryButtonStyle}" Command="{Binding MemoryRecallCommand}" />
        <Button Grid.Row="3" Grid.Column="2" Content="M+" Style="{StaticResource MemoryButtonStyle}" Command="{Binding MemoryAddCommand}" />
        <Button Grid.Row="3" Grid.Column="3" Content="M-" Style="{StaticResource MemoryButtonStyle}" Command="{Binding MemorySubtractCommand}" />
        <Button Grid.Row="3" Grid.Column="4" Content="←" Style="{StaticResource ClearButtonStyle}" Command="{Binding BackspaceCommand}" />

        <Button Grid.Row="4" Grid.Column="0" Content="CE" Style="{StaticResource ClearButtonStyle}" Command="{Binding ClearEntryCommand}" />
        <Button Grid.Row="4" Grid.Column="1" Content="C" Style="{StaticResource ClearButtonStyle}" Command="{Binding ClearCommand}" />
        <Button Grid.Row="4" Grid.Column="2" Content="±" Style="{StaticResource OperationButtonStyle}" Command="{Binding UnaryOperationCommand}" CommandParameter="±" />
        <Button Grid.Row="4" Grid.Column="3" Content="√" Style="{StaticResource OperationButtonStyle}" Command="{Binding UnaryOperationCommand}" CommandParameter="√" />
        <Button Grid.Row="4" Grid.Column="4" Content="%" Style="{StaticResource OperationButtonStyle}" Command="{Binding UnaryOperationCommand}" CommandParameter="%" />

        <Button Grid.Row="5" Grid.Column="0" Content="7" Command="{Binding DigitCommand}" CommandParameter="7" />
        <Button Grid.Row="5" Grid.Column="1" Content="8" Command="{Binding DigitCommand}" CommandParameter="8" />
        <Button Grid.Row="5" Grid.Column="2" Content="9" Command="{Binding DigitCommand}" CommandParameter="9" />
        <Button Grid.Row="5" Grid.Column="3" Content="÷" Style="{StaticResource OperationButtonStyle}" Command="{Binding OperationCommand}" CommandParameter="/" />
        <Button Grid.Row="5" Grid.Column="4" Content="x²" Style="{StaticResource OperationButtonStyle}" Command="{Binding UnaryOperationCommand}" CommandParameter="x²" />

        <Button Grid.Row="6" Grid.Column="0" Content="4" Command="{Binding DigitCommand}" CommandParameter="4" />
        <Button Grid.Row="6" Grid.Column="1" Content="5" Command="{Binding DigitCommand}" CommandParameter="5" />
        <Button Grid.Row="6" Grid.Column="2" Content="6" Command="{Binding DigitCommand}" CommandParameter="6" />
        <Button Grid.Row="6" Grid.Column="3" Content="×" Style="{StaticResource OperationButtonStyle}" Command="{Binding OperationCommand}" CommandParameter="*" />
        <Button Grid.Row="6" Grid.Column="4" Content="1/x" Style="{StaticResource OperationButtonStyle}" Command="{Binding UnaryOperationCommand}" CommandParameter="1/x" />

        <Button Grid.Row="7" Grid.Column="0" Content="1" Command="{Binding DigitCommand}" CommandParameter="1" />
        <Button Grid.Row="7" Grid.Column="1" Content="2" Command="{Binding DigitCommand}" CommandParameter="2" />
        <Button Grid.Row="7" Grid.Column="2" Content="3" Command="{Binding DigitCommand}" CommandParameter="3" />
        <Button Grid.Row="7" Grid.Column="3" Content="−" Style="{StaticResource OperationButtonStyle}" Command="{Binding OperationCommand}" CommandParameter="-" />
        <Button Grid.Row="7" Grid.Column="4" Content="xʸ" Style="{StaticResource OperationButtonStyle}" Command="{Binding OperationCommand}" CommandParameter="^" />

        <Button Grid.Row="8" Grid.Column="0" Content="0" Command="{Binding DigitCommand}" CommandParameter="0" />
        <Button Grid.Row="8" Grid.Column="1" Content="," Command="{Binding DecimalPointCommand}" />
        <Button Grid.Row="8" Grid.Column="2" Content="X→Y" Style="{StaticResource MemoryButtonStyle}" Command="{Binding MoveXToYCommand}" />
        <Button Grid.Row="8" Grid.Column="3" Content="+" Style="{StaticResource OperationButtonStyle}" Command="{Binding OperationCommand}" CommandParameter="+" />
        <Button Grid.Row="8" Grid.Column="4" Content="=" Style="{StaticResource EqualButtonStyle}" Command="{Binding EqualCommand}" />
    </Grid>
</Window>
