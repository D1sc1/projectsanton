<Window x:Class="CardFile.Wpf.Views.CardEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CardFile.Wpf.Views" xmlns:viewmodels="clr-namespace:CardFile.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Правка карточки книги" Height="470" Width="520" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Window.DataContext>
        <viewmodels:CardViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="320" Margin="5" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Автор:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="320" Margin="5" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Жанр:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

        <ComboBox Grid.Row="2" Grid.Column="1" IsEditable="True" Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="200" Margin="5">
            <ComboBoxItem Content="Роман" />
            <ComboBoxItem Content="Повесть" />
            <ComboBoxItem Content="Поэзия" />
            <ComboBoxItem Content="Фантастика" />
            <ComboBoxItem Content="Детектив" />
            <ComboBoxItem Content="Программирование" />
            <ComboBoxItem Content="Учебная литература" />
            <ComboBoxItem Content="Детская литература" />
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Год издания:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PublishYear, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="80" Margin="5" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Издательство:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="200" Margin="5" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Количество страниц:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding PageCount, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="80" Margin="5" />

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Стоимость:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="120" Margin="5" />

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Дата поступления:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

        <DatePicker Grid.Row="7" Grid.Column="1" SelectedDate="{Binding ReceiptDate}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Дата выдачи:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
            <DatePicker SelectedDate="{Binding IssueDate}" IsEnabled="{Binding IsIssueFieldsEnabled}"
                        VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

            <CheckBox IsChecked="{Binding IsAvailable}" VerticalAlignment="Center" Margin="5"
                      Checked="IsAvailableCheckBox_Checked" Unchecked="IsAvailableCheckBox_Unchecked">
                <TextBlock Text="В наличии" VerticalAlignment="Center" />
            </CheckBox>
        </StackPanel>

        <TextBlock Grid.Row="9" Grid.Column="0" Text="Читатель:" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5" />

        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding ReaderName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIssueFieldsEnabled}"
                 VerticalAlignment="Center" HorizontalAlignment="Left" Width="200" Margin="5" />

        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button Content="OK" Padding="5" Margin="5" MinWidth="70" IsDefault="True" Click="OkButton_Click" />

            <Button Content="Отмена" Padding="5" Margin="5" MinWidth="70" IsCancel="True" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
