<Window x:Class="ReversiGame.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReversiGame.Wpf" xmlns:viewmodels="clr-namespace:ReversiGame.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Реверси" Height="620" Width="860" MinHeight="620" MinWidth="860">
    <Window.DataContext>
        <viewmodels:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="SaddleBrown" Padding="8" CornerRadius="6" VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="8" Columns="8" Width="520" Height="520" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid MouseDown="Cell_MouseDown" Background="ForestGreen">
                            <Border BorderBrush="DarkGreen" BorderThickness="1" />

                            <Ellipse Margin="7" Fill="Black" Stroke="Gray" StrokeThickness="1"
                                     Visibility="{Binding IsBlack, Converter={StaticResource BoolToVisibility}}" />

                            <Ellipse Margin="7" Fill="WhiteSmoke" Stroke="Gray" StrokeThickness="1"
                                     Visibility="{Binding IsWhite, Converter={StaticResource BoolToVisibility}}" />

                            <Ellipse Width="16" Height="16" Fill="#66FFFFFF"
                                     Visibility="{Binding IsHintVisible, Converter={StaticResource BoolToVisibility}}" />

                            <Ellipse Width="10" Height="10" Fill="Red"
                                     Visibility="{Binding IsLastMove, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Реверси" FontSize="32" FontWeight="Bold" Margin="0,0,0,10" />
            <TextBlock Text="{Binding ModeText}" FontSize="14" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,15" />

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <Ellipse Width="24" Height="24" Fill="Black" Margin="0,0,10,0" />
                <TextBlock Text="Черные:" FontSize="18" Width="80" />
                <TextBlock Text="{Binding BlackCount}" FontSize="18" FontWeight="Bold" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <Ellipse Width="24" Height="24" Fill="WhiteSmoke" Stroke="Gray" Margin="0,0,10,0" />
                <TextBlock Text="Белые:" FontSize="18" Width="80" />
                <TextBlock Text="{Binding WhiteCount}" FontSize="18" FontWeight="Bold" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,15">
                <TextBlock Text="Ходов сделано: " FontSize="14" />
                <TextBlock Text="{Binding MoveCount}" FontSize="14" />
            </StackPanel>

            <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="Bold" Foreground="DarkGreen" TextWrapping="Wrap" />
            <TextBlock Text="{Binding MessageText}" FontSize="14" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,5,0,15" />

            <CheckBox Content="Подсказывать возможные ходы" IsChecked="{Binding IsHintShown}" Margin="0,5" />
            <CheckBox Content="Играть против компьютера" IsChecked="{Binding IsVsComputer}" Margin="0,5"
                      ToolTip="Режим применяется при начале новой партии" />

            <Button Content="Новая партия" FontSize="16" Padding="10,5" Margin="0,15,0,0" HorizontalAlignment="Left"
                    Click="NewGameButton_Click" />
        </StackPanel>
    </Grid>
</Window>
